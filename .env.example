# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE PRODUCTION CONFIGURATION (Optional - Prototype uses local persistent store + Express API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# WHATSAPP BUSINESS CLOUD API (Server-side only - never expose in client bundle)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# INDIAN DLT SMS GATEWAY (Server-side only)
SMS_PROVIDER_NAME="MSG91"
SMS_PROVIDER_API_KEY=""
SMS_DLT_ENTITY_ID=""
SMS_SENDER_ID="EDUTRK"
